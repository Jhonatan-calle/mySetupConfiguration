{
  "layer": "bottom",
  "position": "top",
  "height": 30,
  "modules-left": ["hyprland/workspaces"],
  "modules-right": [
    //dependnciaas:
    //  rofi-wayland
    //  jq

    "custom/pomodoro",
    "cpu",
    "memory",
    "network",
    "bluetooth",
    "battery",
    "clock",
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "⚠ Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click": "nm-connection-editor", // Abre el gestor de red al hacer clic
  },

  "memory": {
    "format": "RAM {percentage}%",
    "tooltip": true,
    "tooltip-format": "Used: {used:.1f} GB\nAvailable: {avail:.1f} GB",
  },

  "cpu": {
    "format": "CPU {usage}%",
    "tooltip": true,
  },
  "bluetooth": {
    "format": "󰂲 off",
    "format-on": "󰂯 on",
    "format-connected": "󰂱  {device_alias}",
    "format-connected-battery": "󰂱  {device_alias}  {device_battery_percentage}%",
    "format-disconnected": "󰂯  disconnected",
    "tooltip-format": "{controller_alias}  {controller_address}",
    "tooltip-format-connected": "{controller_alias}\n\n{num_connections} conectado(s)\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "  {device_alias}",
    "tooltip-format-enumerate-connected-battery": "  {device_alias}  {device_battery_percentage}%",
    "on-click": "blueman-manager",
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
  },

  "clock": {
    "format": "  {:%d/%m/%Y  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  },

  "custom/pomodoro": {
    "exec": "nice -n 19 ionice -c 3 /home/jhonatan/.config/scripts/pomodoro.py",
    "interval": 1,
    "on-click": "/home/jhonatan/.config/scripts/pomodoro.py toggle",
    "on-click-right": "/home/jhonatan/.config/scripts/pomodoro.py skip",
    "on-click-middle": "/home/jhonatan/.config/scripts/pomodoro.py reset",
    "tooltip": true,
    "return-type": "json",
  },
}
